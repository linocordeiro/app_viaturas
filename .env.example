# Configurações do Ambiente - APP_VIATURAS
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Chave secreta da aplicação (gere uma chave forte e exclusiva em produção)
SECRET_KEY=django-insecure-mude-esta-chave-em-producao-exemplo-app-viaturas-pf

# Modo Debug (True para desenvolvimento local, False em produção)
DEBUG=True

# Hosts autorizados separados por vírgula
ALLOWED_HOSTS=127.0.0.1,localhost
